aws_region         = "us-east-1"
name_prefix        = "cosmos3-vllm-poc"
kubernetes_version = "1.34"

# Use g6e.2xlarge (8 vCPU / 64 GiB). The Deployment requests cpu=6, mem=48Gi,
# which will NOT schedule on g6e.xlarge (4 vCPU / 32 GiB) — if you want the
# xlarge, also lower the pod requests in manifests/.
gpu_instance_type = "g6e.2xlarge"

gpu_node_disk_size = 500

tags = {
  Project     = "cosmos3-nano-vllm-eks-poc"
  Environment = "poc"
  Owner       = "your-name"
}
