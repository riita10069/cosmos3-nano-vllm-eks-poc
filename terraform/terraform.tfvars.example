aws_region         = "us-west-2"
name_prefix        = "cosmos3-vllm-poc"
kubernetes_version = "1.34"
availability_zones = ["us-west-2a", "us-west-2b"]

# Use g6e.2xlarge (8 vCPU / 64 GiB). The Deployment requests cpu=6, mem=48Gi,
# which will NOT schedule on g6e.xlarge (4 vCPU / 32 GiB) — if you want the
# xlarge, also lower the pod requests in manifests/.
gpu_instance_type = "g6e.2xlarge"

gpu_node_disk_size = 500

# These versions were resolved in us-west-2 on 2026-08-22. Update them
# deliberately after verifying compatibility with the selected EKS version.
system_ami_release_version = "1.34.9-20260818"
gpu_ami_release_version    = "1.34.9-20260818"
vpc_cni_addon_version      = "v1.22.4-eksbuild.3"
kube_proxy_addon_version   = "v1.34.6-eksbuild.18"
coredns_addon_version      = "v1.12.4-eksbuild.18"

tags = {
  Project     = "cosmos3-nano-vllm-eks-poc"
  Environment = "poc"
  Owner       = "your-name"
}
